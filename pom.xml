<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.company.store</groupId>
    <artifactId>app-customer-web-portal</artifactId>
    <version>1.0.14-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- 1. Import the BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.company.store</groupId>
                <artifactId>company-dependencies-bom</artifactId>
                <version>1.0.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    

    <!-- 2. Declare dependencies WITHOUT specifying <version> tags -->
    <dependencies>
        <dependency>
            <groupId>com.company.store</groupId>
            <artifactId>common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.company.store</groupId>
            <artifactId>api-user-sdk</artifactId>
            <version>1.0.17</version>
        </dependency>
        <dependency>
            <groupId>com.company.store</groupId>
            <artifactId>api-catalog-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.company.store</groupId>
            <artifactId>engine-order-processing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
